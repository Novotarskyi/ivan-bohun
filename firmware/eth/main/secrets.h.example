/* The mask's reserved LAN address (outside your DHCP pool) and your LAN's
 * gateway - the two deployment specifics the blades need. These are
 * documentation placeholders (RFC 5737) and route nowhere. */
#define BOHUN_MASK_IP "192.0.2.2"
#define BOHUN_MASK_GW "192.0.2.1"

/* Home WiFi, used ONLY by the observers' touch-opened OTA window
